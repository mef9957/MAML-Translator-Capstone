{"type": "text", "id": "text_do_you_like_to_make_stuff", "source_ids": ["src_00021"], "x": 320.0, "y": 1285.44, "z": 18, "w": 560.0, "h": 48.0, "display": "block", "text": "Do you like to make stuff on the web? . I also like .", "backgroundColor": "rgba(0, 0, 0, 0)", "color": "rgb(0, 0, 0)", "fontFamily": "Times", "fontSize": "16px", "fontWeight": "400", "fontStyle": "italic", "textAlign": "left", "border": "0px none rgb(0, 0, 0)", "borderRadius": "0px", "padding": "0px"}
