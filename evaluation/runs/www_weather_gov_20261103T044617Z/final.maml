{"type": "text", "id": "text_headline", "source_ids": ["src_00021"], "x": 290.0, "y": 111.0, "z": 19, "w": 765.45, "h": 32.14, "display": "block", "text": "Severe Weather and Heavy Rainfall in the Plains Tonight; Heavy Rainfall and Flooding Along the East Coast of Florida", "color": "rgb(19, 88, 151)", "fontFamily": "Arial, Helvetica, Geneva, sans-serif", "fontSize": "14.6667px", "fontWeight": "700", "lineHeight": "16.1333px", "textAlign": "start"}
{"type": "text", "id": "text_headline_body", "source_ids": ["src_00022"], "x": 290.0, "y": 153.28, "z": 20, "w": 769.13, "h": 45.0, "display": "block", "text": "Severe thunderstorms with the potential for strong, damaging winds and a few tornadoes are expected through tonight across the central and southern Plains. Heavy rainfall may accompany these thunderstorms. Heavy rainfall will continue through tonight along the east coast of Florida and flooding will continue through Tuesday morning.", "color": "rgb(0, 0, 0)", "fontFamily": "Arial, Helvetica, Geneva, sans-serif", "fontSize": "13.3333px", "textAlign": "start"}
